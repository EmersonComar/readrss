#: src/changelog.rs:28
msgid "Installation and automatic updates through the readrss APT repository."
msgstr ""

#: src/changelog.rs:29
msgid "Debian package with a manual page and the background service enabled for every user."
msgstr ""

#: src/changelog.rs:31
msgid "The installer in the release archive now uses the same launcher and service files as the package."
msgstr ""

#: src/changelog.rs:40
msgid "Subscribe to RSS/Atom feeds by entering the feed or website address; the feed is detected automatically."
msgstr ""

#: src/changelog.rs:43
msgid "Three reading modes: feed summary, full article extracted from the website, and the original page inside the app."
msgstr ""

#: src/changelog.rs:46
msgid "Reliable website icons, validated and cached, with an initials avatar when no icon is available."
msgstr ""

#: src/changelog.rs:47
msgid "Automatic sync every 5 minutes, 30 minutes or 1 hour, downloading only feeds that changed."
msgstr ""

#: src/changelog.rs:48
msgid "Notifications for new articles and an option to keep syncing in the background."
msgstr ""

#: src/changelog.rs:49
msgid "Unread and starred articles, search, and mark all as read."
msgstr ""

#: src/changelog.rs:50
msgid "OPML import and export to migrate from other feed readers."
msgstr ""

#: src/changelog.rs:51
msgid "Interface in Portuguese, English and Spanish, switchable without restarting."
msgstr ""

#: src/changelog.rs:52
msgid "Keyboard shortcuts to navigate and read articles."
msgstr ""

#: src/changelog.rs:53
msgid "About dialog and changelog in the main menu."
msgstr ""

#: src/changelog.rs:54
msgid "Application icon, also used by the launcher."
msgstr ""

#: src/changelog.rs:55
msgid "System installation in /opt with a background service that starts with the session and keeps syncing and notifying without the window open."
msgstr ""

#: src/changelog.rs:58
msgid "Edit a feed's address and name from its context menu."
msgstr ""

#: src/changelog.rs:59
msgid "Per-feed filters by keywords or regular expressions, to hide matching articles or show only them."
msgstr ""

#: src/changelog.rs:63
msgid "Window buttons no longer disappear when the reader pane is made narrow."
msgstr ""

#: src/changelog.rs:64
msgid "No more graphics warnings when maximizing or resizing the window."
msgstr ""

#: src/changelog.rs:65
msgid "Notifications for a newly added feed show its name instead of its address."
msgstr ""

#: src/changelog.rs:66
msgid "Reading articles from many websites no longer piles up browser processes and memory."
msgstr ""

